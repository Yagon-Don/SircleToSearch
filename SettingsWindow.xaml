<ui:FluentWindow x:Class="SircleToSearch.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="SircleToSearch" Height="520" Width="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="SircleToSearch" ShowMaximize="False" ShowMinimize="False"/>

        <StackPanel Grid.Row="1" Margin="20,4,20,20">
            <TextBlock x:Name="WelcomeText" TextWrapping="Wrap" Opacity="0.7" FontSize="13" Margin="0,0,0,16"/>

            <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon Globe24}">
                <ui:CardControl.Header>
                    <TextBlock x:Name="LanguageLabel" VerticalAlignment="Center" FontSize="14"/>
                </ui:CardControl.Header>
                <ComboBox x:Name="LanguageCombo" Width="140" SelectionChanged="LanguageCombo_SelectionChanged">
                    <ComboBoxItem Content="English" Tag="en"/>
                    <ComboBoxItem Content="Русский" Tag="ru"/>
                </ComboBox>
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,8">
                <ui:CardControl.Header>
                    <TextBlock x:Name="AutostartLabel" VerticalAlignment="Center" FontSize="14"/>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="AutostartToggle"
                                 Checked="AutostartToggle_Changed" Unchecked="AutostartToggle_Changed"/>
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,8">
                <ui:CardControl.Header>
                    <TextBlock x:Name="HotkeyInfoText" VerticalAlignment="Center" FontSize="14"/>
                </ui:CardControl.Header>
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,16" Icon="{ui:SymbolIcon ArrowCounterclockwise24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock x:Name="VersionText" FontSize="14"/>
                        <TextBlock x:Name="UpdateStatusText" FontSize="12" Opacity="0.7" Margin="0,2,0,0"/>
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button x:Name="CheckUpdateButton" Appearance="Secondary" Click="CheckUpdateButton_Click"/>
            </ui:CardControl>

            <StackPanel Orientation="Horizontal">
                <ui:Button x:Name="GitHubButton" Appearance="Secondary" Margin="0,0,8,0" Click="GitHubButton_Click"/>
                <ui:Button x:Name="AuthorButton" Appearance="Secondary" Click="AuthorButton_Click"/>
            </StackPanel>

            <Grid Margin="0,24,0,0">
                <TextBlock x:Name="BySomeoneText" Opacity="0.5" FontSize="11" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button x:Name="ReportBugButton" Appearance="Secondary" Icon="{ui:SymbolIcon Bug24}"
                               Margin="0,0,8,0" Click="ReportBugButton_Click"/>
                    <ui:Button x:Name="CloseButton" Appearance="Primary" Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
