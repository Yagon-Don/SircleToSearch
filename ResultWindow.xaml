<Window x:Class="SircleToSearch.ResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="SircleToSearch — результат"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual">
    <Border Background="White" CornerRadius="16,16,0,0"
            BorderBrush="#22000000" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.35" Color="Black"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" CornerRadius="16,16,0,0" Background="#F1F3F4"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#4285F4"/>
                        <TextBlock x:Name="StatusText" Margin="8,0,0,0"
                                   FontFamily="Segoe UI Semibold" FontSize="13" Foreground="#3C4043"/>
                    </StackPanel>
                    <Button x:Name="CloseButton" Content="✕" Width="32" Height="32"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                            BorderThickness="0" Background="Transparent" Foreground="#5F6368"
                            FontSize="13" Cursor="Hand" Click="CloseButton_Click"/>
                </Grid>
            </Border>

            <wv2:WebView2 x:Name="Browser" Grid.Row="1" Visibility="Collapsed"/>

            <!-- WebView2 is a windowed control (its own HWND) — a WPF overlay can't draw
                 on top of it while it's visible (airspace). Collapsing it while loading is
                 what lets this M3-style spinner show instead of a blank/white flash. -->
            <Border x:Name="LoadingOverlay" Grid.Row="1" Background="White" CornerRadius="0,0,16,16">
                <Polygon x:Name="SpinnerShape" Fill="#4285F4"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Width="48" Height="48"/>
            </Border>
        </Grid>
    </Border>
</Window>
